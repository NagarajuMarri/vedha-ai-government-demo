# Copy to backend/.env for local use. Never commit real secret values.
VEDHA_PROJECT_NAME=Vedha AI Government Demo
VEDHA_ENVIRONMENT=development
VEDHA_API_V1_PREFIX=/api/v1
VEDHA_LOG_LEVEL=INFO
VEDHA_CORS_ORIGINS=http://localhost:8080,http://127.0.0.1:8080

# Server-side AI configuration. Leave values blank or safe for local development.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
OPENAI_TIMEOUT_SECONDS=20
AI_PROVIDER=openai
AI_FALLBACK_ENABLED=true
