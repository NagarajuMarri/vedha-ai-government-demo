# Copy to backend/.env for local use. Never commit real secret values.
VEDHA_PROJECT_NAME=Vedha AI Government Demo
VEDHA_ENVIRONMENT=development
VEDHA_API_V1_PREFIX=/api/v1
VEDHA_LOG_LEVEL=INFO
VEDHA_CORS_ORIGINS=http://localhost:8080,http://127.0.0.1:8080

# Server-side AI configuration. Leave values blank or safe for local development.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
OPENAI_TIMEOUT_SECONDS=30
AI_PROVIDER=openai
AI_FALLBACK_ENABLED=true

# Curriculum selection. Add new canonical board IDs without changing resolver code.
SUPPORTED_BOARDS=andhra_pradesh_state_board,telangana_state_board,cbse,icse
DEFAULT_BOARD=andhra_pradesh_state_board
DEFAULT_ACADEMIC_YEAR=2025-2026

# Textbook ingestion is disabled by default. Stored files remain private.
TEXTBOOK_STORAGE_PATH=backend/data/textbooks
TEXTBOOK_MAX_FILE_SIZE_MB=100
TEXTBOOK_ALLOWED_MIME_TYPES=application/pdf
TEXTBOOK_CHECKSUM_ALGORITHM=sha256
TEXTBOOK_INGESTION_ENABLED=false
TEXTBOOK_SCANNED_THRESHOLD=0.8
